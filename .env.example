GNANI_API_KEY=
# An OpenAI-compatible chat-completions endpoint for the semantic scorer.
SCORER_API_KEY=
SCORER_BASE_URL=https://api.openai.com/v1
SCORER_MODEL=
# Optional outbound call backend (keep credentials and phone numbers private).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
TWILIO_TO_NUMBER=
HMH_PUBLIC_BASE_URL=
HMH_CALL_API_URL=http://127.0.0.1:8000
HMH_CALL_API_TOKEN=

# Optional PDF drafting concurrency (1–4).
DOCUMENT_WORKERS=3
# Leave unset for model-specific default; overrides require provider support.
# DOCUMENT_REASONING_EFFORT=none

# Phone demo uses Twilio transcription; paid audio mode: prisma_record.
PHONE_STT_MODE=gather
